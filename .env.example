# VITalWatch — all values optional; these are the defaults.

APP_NAME=VITalWatch
ORG_NAME="All India Institute of Ayurveda — NPvCC"

# --- Database -----------------------------------------------------------------
# Unset: the app runs on a local SQLite file (data/ctms.db) and needs no network.
# Set:   every query runs against Postgres instead. Supabase gives you this string
#        under Project Settings -> Database -> Connection string -> URI.
#
# Use a POOLER host. The direct connection (db.<ref>.supabase.co) is IPv6-only and
# unreachable from most home networks and from Render's free tier. The pooler host
# looks like aws-0-<region>.pooler.supabase.com and the username carries the project
# ref after a dot:
#
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Port 5432 is the session pooler and 6543 the transaction pooler; both work, because
# server-side prepared statements are disabled in app/db.py for exactly this reason.
# sslmode=require is added automatically if the URL does not already carry it.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=10

# Alert thresholds — change one and refresh to prove they are configurable.
ENROLMENT_LAG_PCT=80
ETHICS_RENEWAL_DAYS=60
MONITORING_OVERDUE_DAYS=14

# Statutory clocks, New Drugs and Clinical Trials Rules 2019.
SAE_INITIAL_REPORT_HOURS=24
SAE_NARRATIVE_DAYS=14
