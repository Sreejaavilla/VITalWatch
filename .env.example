# ---- mode ----
STUB_MODE=true                      # backend: serve contracts/fixtures, no DB needed
NEXT_PUBLIC_STUB_MODE=true          # frontend: read mocks/, no backend needed

# ---- supabase (Caleb) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # backend only, never ship to frontend
SUPABASE_JWT_SECRET=
DATABASE_URL=                       # postgres connection string

# ---- backend (Kavin) ----
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- audit (Caleb) ----
AUDIT_CHAIN_SEED=vitalwatch-genesis

# ---- alert thresholds (Kavin) ----
ALERT_ENROLMENT_LAG_PCT=80          # alert when actual < this % of expected-by-date
ALERT_ETHICS_RENEWAL_DAYS=30        # alert when EC/CTRI approval expires within N days
ALERT_MONITORING_VISIT_GRACE_DAYS=7 # alert when a monitoring visit is N days overdue

# ---- pharmacovigilance (Sreeja) ----
PV_EMBEDDINGS_PATH=services/pv/coding/embeddings.npy
PV_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
PV_CODING_BACKEND=mock              # mock | faiss

# ---- datagen (Roxy) ----
DATAGEN_SEED=1947                   # fixed seed = reproducible demo
